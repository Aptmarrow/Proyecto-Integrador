{
  "openapi": "3.0.3",
  "info": {
    "title": "Danmakrew API — NoMercyGames",
    "description": "API REST oficial de Danmakrew: autenticación JWT, usuarios, amigos, inventario de chips y salas cooperativas en tiempo real (complementada por WebSockets en `/signal` y `/game`).",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtenido desde POST /api/auth/login"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 11,
            "example": "Rodri"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "player@nomercygames.me"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "secret123"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "player@nomercygames.me"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          }
        }
      },
      "ResendVerificationRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "player@nomercygames.me"
          }
        }
      },
      "CreateChipRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Overclock Core"
          },
          "rarity": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "stats": {
            "type": "object",
            "nullable": true,
            "properties": {
              "HP": {
                "type": "number",
                "nullable": true
              },
              "Bullet_Damage": {
                "type": "number",
                "nullable": true
              },
              "SP_Charge": {
                "type": "number",
                "nullable": true
              },
              "Defense": {
                "type": "number",
                "nullable": true
              },
              "Ultimate_Damage": {
                "type": "number",
                "nullable": true
              },
              "Cadency": {
                "type": "number",
                "nullable": true
              },
              "Critic_Chance": {
                "type": "number",
                "nullable": true
              },
              "Crit_Damage": {
                "type": "number",
                "nullable": true
              }
            }
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "example": "NO MERCY LOBBY"
          },
          "map": {
            "type": "string",
            "example": "classic"
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "example": 4
          },
          "password": {
            "type": "string",
            "maxLength": 64
          },
          "isPublic": {
            "type": "boolean",
            "example": true
          },
          "difficulty": {
            "type": "string",
            "example": "normal"
          },
          "world": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "example": 1
          },
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "example": 1
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        },
        "tags": [
          "Health"
        ],
        "summary": "Información básica de la API"
      }
    },
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        },
        "tags": [
          "Health"
        ],
        "summary": "Healthcheck de API, base de datos PostgreSQL y puerto WebSocket"
      }
