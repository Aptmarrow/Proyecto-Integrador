# ---- Servidor ----
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
WS_PORT=9001

# ---- Base de datos (PostgreSQL / Neon) ----
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_db_password_here

# ---- Redis ----
# URL de conexión a Redis. En Docker Compose usar redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# ---- Mailer (Nodemailer / Gmail) ----
# Usa un correo de Gmail y una "Contraseña de Aplicación" de 16 caracteres
EMAIL_USER=justanexamplemail@gmail.com
EMAIL_PASS=just_an_example_password

# ---- Frontend / CORS ----
# Lista separada por comas de orígenes permitidos
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://nomercygames.me

# ---- JWT Auth ----
JWT_SECRET=change-this-to-a-long-random-hex-secret
JWT_EXPIRES_IN=7d
JWT_AUDIENCE=DanmakrewUsers
